# Copy to .env and adjust for this machine. Never commit .env.
MIRROR_HOST=127.0.0.1
MIRROR_PORT=5000
MIRROR_LOG_LEVEL=INFO
# Local browser time, 12 or 24 hours.
MIRROR_CLOCK_FORMAT=24
# Optional size adjustment, from 0.75 to 1.5.
MIRROR_DISPLAY_SCALE=1.0
# Comma-separated placeholders to show; empty hides all optional regions.
MIRROR_MODULES=weather,news,pihole,system,assistant
# Coordinates are intentionally blank; set both for Open-Meteo weather.
MIRROR_WEATHER_LATITUDE=
MIRROR_WEATHER_LONGITUDE=
MIRROR_WEATHER_UNIT=celsius
# Comma-separated RSS/Atom URLs; blank keeps news unconfigured.
MIRROR_NEWS_FEEDS=
# Pi-hole v6 base URL; password file is optional if its read API is public.
MIRROR_PIHOLE_URL=http://127.0.0.1
MIRROR_PIHOLE_PASSWORD_FILE=
# Optional absolute path to a trusted Pi-hole CA certificate for verified HTTPS.
MIRROR_PIHOLE_CA_CERT=
# Refresh schedules in seconds. Successful data stays in memory if a source fails.
MIRROR_SYSTEM_INTERVAL=15
MIRROR_WEATHER_INTERVAL=900
MIRROR_NEWS_INTERVAL=1800
MIRROR_PIHOLE_INTERVAL=60
# Optional RGB LED. BCM pins match the verified Pi 4B wiring; GPIO is untouched by default.
MIRROR_LED_ENABLED=false
MIRROR_LED_RED_PIN=22
MIRROR_LED_GREEN_PIN=27
MIRROR_LED_BLUE_PIN=24
MIRROR_LED_ACTIVE_HIGH=true
MIRROR_LED_INITIAL_STATE=off
# Optional audio. Inspect PortAudio device names with the standalone CLI before enabling.
MIRROR_AUDIO_ENABLED=false
# On the tested Pi, use pipewire and set the exact expected source below; direct USB ALSA had overflows.
MIRROR_AUDIO_INPUT_DEVICE=USB PnP Sound Device
# Required for logical pipewire input: exact expected physical node.name from wpctl.
MIRROR_AUDIO_EXPECTED_INPUT_SOURCE=
MIRROR_AUDIO_OUTPUT_DEVICE=MAX98357A
MIRROR_AUDIO_CAPTURE_RATE=48000
MIRROR_AUDIO_PLAYBACK_RATE=48000
MIRROR_AUDIO_CAPTURE_CHANNELS=1
MIRROR_AUDIO_PLAYBACK_CHANNELS=1
MIRROR_AUDIO_BUFFER_DURATION=0.1
MIRROR_AUDIO_FRAME_FORMAT=int16
MIRROR_AUDIO_PLAYBACK_GAIN=1.0
MIRROR_AUDIO_MAX_PLAYBACK_LEVEL=1.0
MIRROR_AUDIO_TIMEOUT=5.0
# Pass 6A Realtime is opt-in. The key stays only in the ignored local .env.
OPENAI_API_KEY=
MIRROR_REALTIME_MODEL=gpt-realtime-2.1-mini
MIRROR_REALTIME_MAX_SESSION_SECONDS=900
MIRROR_REALTIME_IDLE_SECONDS=60
MIRROR_REALTIME_MAX_RESPONSE_SECONDS=90
MIRROR_REALTIME_CONNECT_TIMEOUT=10
MIRROR_REALTIME_RETRY_LIMIT=2
MIRROR_REALTIME_BACKOFF_SECONDS=1.0
# Pass 6C: optional local wake detection. Disabled until explicitly started.
MIRROR_WAKE_ENABLED=false
# English phrase for the locally installed Sherpa-ONNX keyword model.
MIRROR_WAKE_PHRASE=magic mirror
# Absolute path to extracted, ignored model directory; required when enabled.
MIRROR_WAKE_MODEL_DIR=
MIRROR_WAKE_COOLDOWN_SECONDS=5.0
MIRROR_WAKE_THRESHOLD=0.35
# Close a false activation if no speech follows the wake cue.
MIRROR_WAKE_FIRST_SPEECH_SECONDS=8
